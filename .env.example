BANK_DATA_DIR=data
# Docker 标准模式：内部暂存库。首次运行 make staging-up 自动创建独立账号及密码。
# 不连接 MySQL 的小数据开发可显式设 sqlite（20 MiB / 5 万行上限）。
BANK_STAGING_BACKEND=mysql
BANK_STAGING_MYSQL_HOST=127.0.0.1
BANK_STAGING_MYSQL_PORT=3306
BANK_STAGING_MYSQL_DATABASE=bank_staging
BANK_STAGING_MYSQL_USER=bank_staging
BANK_STAGING_MYSQL_PASSWORD=
BANK_INTAKE_MAX_UPLOAD_MB=512
BANK_INTAKE_MAX_EXPANDED_MB=8192
BANK_INTAKE_MAX_ROWS=2000000
BANK_INTAKE_MAX_CELLS=200000000
# BANK_API_TOKEN=replace-with-your-own-random-token

# 外部 MySQL 数据源：只用于读取；绝不能填内部暂存账号。
# 本地 mock 装载工具也使用此配置；银行源应使用独立只读账号。
BANK_MYSQL_HOST=127.0.0.1
BANK_MYSQL_PORT=3306
BANK_MYSQL_DATABASE=bank_project
BANK_MYSQL_USER=bank_app
BANK_MYSQL_PASSWORD=
BANK_MYSQL_DOCKER_HOST=mysql
BANK_MYSQL_DOCKER_PORT=3306

# 业务图数据库：主动生成/查看图谱时使用，与本体库分开。
BANK_NEO4J_URI=bolt://127.0.0.1:7690
BANK_NEO4J_USER=neo4j
BANK_NEO4J_PASSWORD=
BANK_NEO4J_DATABASE=neo4j
# 表格、TXT、BFO 浏览和风险规则统一使用同一本体 API。
# 服务端只读访问；不需要远端 Neo4j 账号，不修改业务图数据库配置。
BANK_ONTOLOGY_BASE_URL=http://192.168.130.250:30080/v2/ontologies/00000000-0000-4000-8000-000000000001
# 固定 Legacy BFO；切换本体时应同时核对本体 ID 与 revision。
BANK_ONTOLOGY_REVISION=f32572317cda4b3b9c4357246b3417a3e9c54054c112bb75142e0345a7a21766
# 仅用于历史任务迁移/离线目录；配置远端后，新任务不依赖此文件。
BANK_ONTOLOGY_SNAPSHOT=data/ontology/snapshot.json
# BANK_RETRIEVE_BASE_URL 和 BANK_RISK_ONTOLOGY_BASE_URL 仍兼容，若保留必须与上面一致。
# 任务依据自动保存到 BANK_DATA_DIR/ontology/snapshots，需随运行数据备份。
BANK_RETRIEVE_TIMEOUT_SECONDS=60
BANK_RETRIEVE_CONCURRENCY=3
BANK_ALIGNMENT_MIN_CONFIDENCE=0.75
# 宽表统一概览后逐批解释字段；限制并发，避免占满模型服务。
BANK_ALIGNMENT_BATCH_COLUMNS=32
BANK_ALIGNMENT_MODEL_CONCURRENCY=3

# 模型只解释结构、字段与分组，不选择本体节点；最多 5 行截取样例，不发送全表。
BANK_MODEL_PROVIDER=dashscope
BANK_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BANK_MODEL_NAME=qwen3.7-plus
BANK_MODEL_API_KEY=
BANK_MODEL_TIMEOUT_SECONDS=120
BANK_MODEL_MAX_TOKENS=16384
BANK_MODEL_MAX_RETRIES=2

# TXT GraphRAG：执行文档分块、实体/关系抽取、社区报告和向量索引。
# 聊天配置不填时继承 BANK_MODEL_*；向量模型需与实际服务兼容。
# GraphRAG 会将上传正文发送给你配置的模型服务。
# BANK_GRAPHRAG_CHAT_MODEL=
# BANK_GRAPHRAG_API_BASE=
# BANK_GRAPHRAG_API_KEY=
BANK_GRAPHRAG_EMBEDDING_MODEL=text-embedding-v4
# 向量地址/密钥不填时继承 GraphRAG 聊天地址/密钥。
# BANK_GRAPHRAG_EMBEDDING_API_BASE=
# BANK_GRAPHRAG_EMBEDDING_API_KEY=
BANK_GRAPHRAG_CHUNK_SIZE=1200
BANK_GRAPHRAG_CHUNK_OVERLAP=100
# 文本抽取/社区报告比表结构解释耗时更长。
BANK_GRAPHRAG_REQUEST_TIMEOUT_SECONDS=600
# 原企业情报方案（8 类中文实体）；可在 TXT 接入页面选择 general。
BANK_GRAPHRAG_DEFAULT_PROFILE=enterprise_zh
# 企业方案摘要及社区报告模型；DashScope 默认 qwen-flash，其他服务默认复用聊天模型。
# BANK_GRAPHRAG_FAST_CHAT_MODEL=qwen-flash
# 原消歧实验与新运行保存目录；默认 data/resolution/experiments。
# BANK_RESOLUTION_EXPERIMENTS_DIR=data/resolution/experiments
