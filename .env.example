# Local Python can start without a database; Compose enables Neo4j explicitly.
BANK_GRAPH_BACKEND=none
BANK_NEO4J_URI=bolt://127.0.0.1:7690
BANK_NEO4J_USER=neo4j
# Set a password before starting Compose; no shared default is provided.
BANK_NEO4J_PASSWORD=
BANK_NEO4J_DATABASE=neo4j
BANK_HEALTH_TIMEOUT_SECONDS=2
