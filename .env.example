# 通用导入、转换服务：路径按启动目录解析。Docker 内路径由 Compose 覆盖。
BANK_DATA_DIR=data/preparation
BANK_IMPORT_ROOT=examples/mock
BANK_MAPPING_DIR=configs/mappings
BANK_MAX_FILE_BYTES=20971520
BANK_MAX_RECORDS=50000
# 每个进程最多同时执行的导入/转换请求；超出返回 503，不在内存中排队。
BANK_MAX_CONCURRENT_JOBS=2
# 可选 API 鉴权：取消注释并填写至少 24 个字符的随机值，Swagger 点 Authorize 使用。
# BANK_API_TOKEN=replace-with-your-own-random-token

# 文档抽取：表格映射不需要模型。启用后只向这里明确配置的服务发送文档正文。
BANK_MODEL_ENABLED=false
BANK_MODEL_BASE_URL=
BANK_MODEL_NAME=
BANK_MODEL_API_KEY=
BANK_MODEL_TIMEOUT_SECONDS=30
# 可选：自定义抽取规则和 few-shot；接口会附加统一输出 schema。
# BANK_MODEL_PROMPT_FILE=configs/prompts/extraction.txt

# API 将 MySQL 作为只读来源。make mock-db 单独建表并导入本项目合成数据。
BANK_MYSQL_SOURCE_ENABLED=false
BANK_MYSQL_SOURCE_TABLES=[]
BANK_MYSQL_HOST=127.0.0.1
BANK_MYSQL_PORT=3306
BANK_MYSQL_DATABASE=bank_project
BANK_MYSQL_USER=bank_app
BANK_MYSQL_PASSWORD=
# Docker API 连接地址；本地 Python 使用上面的 HOST/PORT。
BANK_MYSQL_DOCKER_HOST=mysql
BANK_MYSQL_DOCKER_PORT=3306

# 图数据库为后续阶段的可选依赖，前两步不需要连接它。
# Docker 启用时使用 docker compose --profile graph up -d --wait。
BANK_NEO4J_ENABLED=false
BANK_NEO4J_URI=bolt://127.0.0.1:7690
BANK_NEO4J_USER=neo4j
BANK_NEO4J_PASSWORD=
BANK_NEO4J_DATABASE=neo4j
BANK_HEALTH_TIMEOUT_SECONDS=2
